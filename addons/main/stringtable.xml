<?xml version="1.0" encoding="utf-8"?>
<Project name="no_actions">
    <Package name="main">
        <Key ID="STR_no_actions_main_LoadEmptyMagazine">
            <English>Reload (unloaded weapon)</English>
        </Key>
        <Key ID="STR_no_actions_main_LoadEmptyMagazine_desc">
            <English>Hides the Reload entry from the action menu when the weapon is unloaded.\nWARNING: THIS SETTING AFFECTS VEHICLES TOO.</English>
        </Key>
        <Key ID="STR_no_actions_main_LoadOtherMagazine">
            <English>Reload (loaded weapon)</English>
        </Key>
        <Key ID="STR_no_actions_main_LoadOtherMagazine_desc">
            <English>Hides the Reload entry from the action menu when the weapon is loaded.\nWARNING: THIS SETTING AFFECTS VEHICLES TOO.</English>
        </Key>
        <Key ID="STR_no_actions_main_UseMagazine">
            <English>Use Magazine</English>
        </Key>
        <Key ID="STR_no_actions_main_UseMagazine_desc">
            <English>Hides the Use Magazine entry from the action menu when the weapon is unloaded.</English>
        </Key>
        <Key ID="STR_no_actions_main_UseWeapon">
            <English>Use Weapon</English>
        </Key>
        <Key ID="STR_no_actions_main_UseWeapon_desc">
            <English>Hides the Use Weapon entry from the action menu when the weapon is unloaded.</English>
        </Key>
        <Key ID="STR_no_actions_main_User">
            <English>User Actions</English>
        </Key>
        <Key ID="STR_no_actions_main_User_desc">
            <English>Hides the User actions added via the addAction command.\nWARNING: USE AT OWN RISK.</English>
        </Key>
        <Key ID="STR_no_actions_main_action">
            <English>Hide %1 action</English>
        </Key>
        <Key ID="STR_no_actions_main_action_desc">
            <English>Hides the %1 entry from the action menu.</English>
        </Key>
    </Package>
</Project>
